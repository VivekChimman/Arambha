# Arambha AI — env schema (Vivek AI Group standard variable names).
# Copy to .env and fill values YOURSELF. Code never reads .env directly;
# lib/env.ts is the only process.env reader, and every feature degrades
# gracefully when its variables are absent.
#
# ✅ = consumed by code today · ⏳ = reserved (standard name, not wired yet)

# --- Infrastructure ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # ✅ canonical base URL

# --- LLM (roadmap engine) ---
# ONE selected model does the work — no model-to-model fallback. Pick it with
# ARAMBHA_LLM_MODEL (a registry id from lib/config.ts); empty → default gemini-flash.
ARAMBHA_LLM_MODEL=            # ✅ e.g. gemini-flash | claude-sonnet | gpt-mini | groq-llama | mistral-small | sarvam-m
ANTHROPIC_API_KEY=            # ✅
OPENAI_API_KEY=              # ✅
GEMINI_API_KEY=              # ✅ (default model's provider)
GROQ_API_KEY=                # ✅
MISTRAL_API_KEY=             # ✅
SARVAM_API_KEY=              # ✅

# --- Deep research (retrieval) ---
# Search falls back Tavily → SearXNG → Serper (unlike the LLM, no fallback).
TAVILY_API_KEY=              # ✅ primary web search (1,000 credits/mo free)
FIRECRAWL_API_KEY=           # ✅ optional deep extraction (500 credits ONE-TIME free)
SEARXNG_URL=                 # ⏳ free self-hosted search fallback, e.g. https://searx.example.com
SERPER_API_KEY=              # ⏳ cheap Google-results fallback (2,500 free, then ~$1/1k)

# --- Rate limit (Upstash Redis REST — planned) ---
UPSTASH_REDIS_REST_URL=       # ⏳ absent → rate limiting disabled (fail-open)
UPSTASH_REDIS_REST_TOKEN=     # ⏳
IP_HASH_SALT=                 # ⏳ salts IP hashes for rate-limit keys

# --- DODO Payments (report unlock — planned) ---
DODO_PAYMENTS_ENVIRONMENT=test_mode   # ⏳ test_mode | live_mode
DODO_PAYMENTS_API_KEY=                # ⏳ absent → checkout runs in demo mode
DODO_PAYMENTS_WEBHOOK_SECRET=         # ⏳
DODO_ARAMBHA_REPORT_PRODUCT_ID=       # ⏳ Arambha's OWN product id — never reuse another project's

# --- Supabase (report persistence — planned) ---
SUPABASE_URL=                 # ⏳
SUPABASE_ANON_KEY=            # ⏳
SUPABASE_SERVICE_ROLE_KEY=    # ⏳
